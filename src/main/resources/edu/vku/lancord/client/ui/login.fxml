<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.vku.lancord.client.ui.LoginController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="LANCord">
        <font>
            <Font name="System Bold" size="36.0" />
        </font>
    </Label>
    <Label text="Welcome back!" textFill="#b5bac1">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox alignment="CENTER_LEFT" spacing="5.0">
        <Label text="SERVER IP" textFill="#b5bac1">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="serverIpField" promptText="127.0.0.1" />
    </VBox>

    <VBox alignment="CENTER_LEFT" spacing="5.0">
        <Label text="USERNAME" textFill="#b5bac1">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <TextField fx:id="usernameField" promptText="Enter username" />
    </VBox>

    <Button fx:id="loginButton" mnemonicParsing="false" onAction="#onLoginClick" prefWidth="200.0" text="Log In" textFill="WHITE" style="-fx-background-color: #5865F2;" />
</VBox>
