<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.vku.lancord.client.ui.components.ChatFileMessageController"
      styleClass="chat-message-row" spacing="0">
    <padding><Insets top="2" bottom="2" left="16" right="16"/></padding>

    <!-- Sender name + time (same as text message) -->
    <HBox spacing="16" alignment="TOP_LEFT">
        <StackPane minWidth="36" minHeight="36" maxWidth="36" maxHeight="36">
            <javafx.scene.shape.Circle fx:id="avatarCircle" radius="18" fill="#5865F2"/>
            <Label fx:id="avatarInitial" text="?"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
        </StackPane>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="senderLabel" styleClass="message-sender-name"/>
                <Label fx:id="timestampLabel" styleClass="message-timestamp"/>
            </HBox>
            <!-- File card -->
            <HBox styleClass="file-card" spacing="12" alignment="CENTER_LEFT"
                  maxWidth="420">
                <padding><Insets top="10" bottom="10" left="14" right="14"/></padding>
                <!-- File type icon -->
                <Label fx:id="fileIconLabel" text="📄" styleClass="file-icon-label"/>
                <!-- File info -->
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="fileNameLabel" styleClass="file-name-label" wrapText="true"/>
                    <Label fx:id="fileSizeLabel" styleClass="file-size-label"/>
                </VBox>
                <!-- Action button -->
                <Button fx:id="actionButton" text="⬇ Tải về"
                        styleClass="download-btn" onAction="#onActionClicked"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="message-timestamp" text=""/>
        </VBox>
    </HBox>
</VBox>
