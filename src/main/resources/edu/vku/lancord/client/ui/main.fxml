<?xml version="1.0" encoding="UTF-8"?>

import javafx.geometry.Insets?>
import javafx.scene.control.Button?>
import javafx.scene.control.Label?>
import javafx.scene.control.ListView?>
import javafx.scene.control.SplitPane?>
import javafx.scene.control.TextField?>
import javafx.scene.layout.BorderPane?>
import javafx.scene.layout.HBox?>
import javafx.scene.layout.VBox?>
import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.vku.lancord.client.ui.MainController">
    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #2F3136;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="ONLINE USERS" textFill="#8e9297">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <ListView fx:id="onlineUsersList" prefHeight="200.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" />
            
            <Label text="GROUPS" textFill="#8e9297">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <ListView fx:id="groupsList" prefHeight="150.0" style="-fx-background-color: transparent;" />
            
            <Label text="CHANNELS" textFill="#8e9297">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <ListView fx:id="channelsList" prefHeight="150.0" style="-fx-background-color: transparent;" />
        </VBox>
    </left>
    
    <center>
        <VBox style="-fx-background-color: #36393F;" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-border-color: transparent transparent #202225 transparent; -fx-border-width: 0 0 2 0;">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>
                <Label fx:id="currentChatLabel" text="Select a user or channel to chat" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Button fx:id="goLiveButton" disable="true" mnemonicParsing="false" onAction="#onGoLive" text="Go Live" textFill="WHITE" style="-fx-background-color: #43B581;" />
            </HBox>
            
            <ListView fx:id="chatArea" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" />
            
            <HBox alignment="CENTER" prefHeight="60.0" spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                </padding>
                <Button fx:id="uploadButton" mnemonicParsing="false" text="+" />
                <TextField fx:id="messageField" onAction="#onSendMessage" promptText="Message..." style="-fx-background-radius: 8;" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#onSendMessage" text="Send" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
