<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" stylesheets="@discord-theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.vku.lancord.client.ui.MainController">
    <left>
        <HBox BorderPane.alignment="CENTER">
            <!-- Server List icon -->
            <VBox alignment="TOP_CENTER" prefWidth="72.0" spacing="10.0" styleClass="server-bg">
                <padding><Insets bottom="12.0" top="12.0"/></padding>
                <Button mnemonicParsing="false" prefHeight="48.0" prefWidth="48.0"
                        style="-fx-background-color: #5865F2; -fx-background-radius: 24; -fx-text-fill: white; -fx-font-size: 18;"
                        text="LC"/>
                <VBox prefHeight="2.0" prefWidth="32.0" style="-fx-background-color: #35363C; -fx-background-radius: 1;">
                    <VBox.margin><Insets left="20.0" right="20.0"/></VBox.margin>
                </VBox>
            </VBox>

            <!-- Channels / DMs Sidebar -->
            <VBox prefWidth="240.0" spacing="10.0" styleClass="sidebar-bg">
                <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>

                <Label text="DIRECT MESSAGES" textFill="#949BA4">
                    <font><Font name="System Bold" size="12.0"/></font>
                    <VBox.margin><Insets top="10.0"/></VBox.margin>
                </Label>
                <ListView fx:id="onlineUsersList" prefHeight="250.0" VBox.vgrow="ALWAYS"/>

                <Label text="GROUPS" textFill="#949BA4">
                    <font><Font name="System Bold" size="12.0"/></font>
                </Label>
                <ListView fx:id="groupsList" prefHeight="120.0"/>

                <Label text="CHANNELS" textFill="#949BA4">
                    <font><Font name="System Bold" size="12.0"/></font>
                </Label>
                <ListView fx:id="channelsList" prefHeight="120.0"/>
            </VBox>
        </HBox>
    </left>

    <center>
        <VBox styleClass="dark-bg" BorderPane.alignment="CENTER">
            <!-- Header Bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="15.0"
                  style="-fx-border-color: transparent transparent #1E1F22 transparent; -fx-border-width: 0 0 1 0;">
                <padding><Insets left="16.0" right="16.0"/></padding>
                <Label text="#" textFill="#80848E">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>
                <Label fx:id="currentChatLabel" text="general" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0"/></font>
                </Label>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="goLiveButton" disable="true" mnemonicParsing="false" onAction="#onGoLive"
                        style="-fx-background-color: #23A559; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Go Live"/>
            </HBox>

            <!-- Chat Area: ScrollPane + VBox instead of ListView -->
            <ScrollPane fx:id="chatScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true"
                        styleClass="chat-scroll-pane" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox fx:id="chatBox" styleClass="chat-box" spacing="2"/>
            </ScrollPane>

            <!-- Input Area -->
            <HBox alignment="CENTER" prefHeight="68.0" spacing="16.0">
                <padding><Insets bottom="24.0" left="16.0" right="16.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0"
                      style="-fx-background-color: #383A40; -fx-background-radius: 8px;" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="6.0" left="16.0" right="16.0" top="6.0"/></padding>
                    <Button fx:id="uploadButton" mnemonicParsing="false" onAction="#onUploadFile" text="+"/>
                    <TextField fx:id="messageField" onAction="#onSendMessage"
                               promptText="Message..." style="-fx-background-color: transparent;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
